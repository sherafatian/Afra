APP_NAME=Afra
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=afra
DB_USERNAME=afra
DB_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
FRONTEND_ORIGINS=http://localhost:5173
JWT_ISSUER=afra
LOG_CHANNEL=stderr
LOG_LEVEL=warning
HASH_DRIVER=argon2id

# Set exact load-balancer IPs/CIDRs for deployment; never use wildcard trust.
TRUSTED_PROXIES=
JWT_SIGNING_KID=primary
# JSON map of previous kid -> absolute public-key path; never put private keys here.
JWT_PREVIOUS_PUBLIC_KEYS={}
