# TEMPLATE: replace hostname, certificate paths and source paths before use.
# Requires PHP8.4-FPM and a built FrontEnd/dist. No Docker required.
server {
    listen 80;
    server_name afra.example.org;
    return 301 https://afra.example.org$request_uri;
}
server {
    listen 443 ssl http2;
    server_name afra.example.org;
    ssl_certificate /etc/afra/tls/fullchain.pem;
    ssl_certificate_key /etc/afra/tls/private.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/afra/FrontEnd/dist;
    index index.html;
    server_tokens off;
    client_max_body_size 24m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    # Laravel source, .env, vendor and keys are NEVER the static site's document root.
    location ^~ /api/ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /opt/afra/BackEnd/public/index.php;
        fastcgi_param DOCUMENT_ROOT /opt/afra/BackEnd/public;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_read_timeout 125s;
        fastcgi_buffering off;
        add_header Cache-Control "private, no-store" always;
    }
    location ~ /\. { deny all; }
    location ~ \.php$ { return 404; }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    }
}
